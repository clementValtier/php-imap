{
    "name": "acucchieri/php-imap",
    "description": "provides support for IMAP operations",
    "keywords": ["php", "imap"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-imap": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "AC\\Imap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AC\\Imap\\Tests\\": "tests/"
        }
    }
}
